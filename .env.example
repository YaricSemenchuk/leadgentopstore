# --- LLM провайдер для квалификации лидов ---
# Выбери один. По умолчанию anthropic (Sonnet 5.5): знает издателей и их группы, ~$0.006 за лид.
LLM_PROVIDER=anthropic          # anthropic | groq
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low             # low | medium | high; для классификации хватает low

# Альтернатива: Qwen3-Coder через Groq (OpenAI-совместимый endpoint)
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen-2.5-coder-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- База ---
DATABASE_URL=postgres://user:pass@host:5432/appstore_leads

# --- Параметры прохода ---
# Коды сторфронтов Apple через запятую. Пусто = дефолтная выборка топ-стран (см. config.ts).
COUNTRIES=
CHARTS=top-free,top-grossing   # top-free | top-paid | top-grossing
CHART_LIMIT=100                # позиций из каждого чарта (макс 100); глубже — больше средних приложений
CONCURRENCY=3                  # параллельных запросов к RSS Apple (при большем лимит отвечает 403)
PORT=3000
# Категории (iTunes genre id через запятую, all — общий чарт). Пусто = набор из config.ts.
GENRES=

# --- Таргетинг: только малые и средние издатели ---
EXCLUDE_PUBLISHERS=           # подстроки названий издателей через запятую; пусто = список крупных групп из config.ts
MAX_APP_RATINGS=100000         # приложения с большим числом отзывов — гиганты, в LLM не идут
MAX_PUBLISHER_RATINGS=1000000  # суммарно отзывов на портфель издателя
MAX_LLM_PER_RUN=300            # потолок запросов к модели за проход (~$1.8 на Sonnet 5.5)
REQUALIFY_DAYS=7               # недавно оценённых не оцениваем повторно

# --- Контакты ---
CONTACTS_CONCURRENCY=3
CONTACTS_RECHECK_DAYS=30

# --- Доступ (обязательно на Railway) ---
DASHBOARD_PASSWORD=            # пароль на дашборд и CSV (логин любой)
INGEST_TOKEN=                  # POST /ingest с заголовком Authorization: Bearer <токен>

# --- Автопоиск LinkedIn (serper.dev: 2 500 бесплатных запросов, без карты) ---
SERPER_API_KEY=                # пусто — автопоиск выключен
LINKEDIN_SEARCH_MAX_PER_RUN=300  # лидов за прогон; на лид 2 запроса (компания + люди)
